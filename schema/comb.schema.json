{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bostinsteveaustin/comb/main/schema/comb.schema.json",
  "title": "Comb 0.2",
  "description": "Definitions for the three kinds of Comb file: project, cell and journey. The checker picks the definition by where the file sits.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lower-case words joined by hyphens. Unique within the project."
    },
    "version": {
      "enum": ["0.1", "0.2"],
      "description": "The version the file is written to. Every file in a comb declares the same one. A 0.1 file uses nothing that 0.2 added."
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pointer": {
      "description": "Where a real artefact lives. A pointer never copies the artefact.",
      "oneOf": [
        {
          "type": "object",
          "required": ["path", "at"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "description": "Omit for the repository the Comb files live in." },
            "path": { "type": "string" },
            "at": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "The commit the pointer was true at." },
            "lines": { "type": "string", "pattern": "^\\d+(-\\d+)?$" },
            "anchor": { "type": "string", "description": "A heading, requirement ID or function name inside the file." },
            "kind": { "$ref": "#/$defs/pointerKind" }
          }
        },
        {
          "type": "object",
          "required": ["url", "seen"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https?://" },
            "seen": { "$ref": "#/$defs/date" },
            "anchor": { "type": "string" },
            "kind": { "$ref": "#/$defs/pointerKind" }
          }
        }
      ]
    },
    "pointerKind": {
      "enum": ["document", "scenario", "design", "code", "test", "schema", "config", "measure", "other"]
    },
    "statement": {
      "type": "object",
      "required": ["says", "pointer"],
      "additionalProperties": false,
      "properties": {
        "says": { "type": "string", "description": "What this source says, in one plain sentence." },
        "pointer": { "$ref": "#/$defs/pointer" }
      }
    },
    "condition": {
      "enum": ["unexamined", "empty", "not_applicable", "unchecked", "agrees", "disputed", "open", "settled", "unreachable"]
    },
    "mark": {
      "description": "A condition and the evidence it needs. Shared by faces, seams and borders.",
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "statements": { "type": "array", "items": { "$ref": "#/$defs/statement" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/pointer" } },
        "question": { "$ref": "#/$defs/id" },
        "decision": { "$ref": "#/$defs/id" },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "proposed_by": { "type": "string", "description": "The tool, agent or person that put this mark here." },
        "confirmed_by": { "type": "string", "description": "The person who checked the mark and stands behind it." }
      }
    },
    "face": {
      "allOf": [{ "$ref": "#/$defs/mark" }],
      "properties": {
        "condition": true, "statements": true, "evidence": true, "question": true,
        "decision": true, "reason": true, "note": true,
        "proposed_by": true, "confirmed_by": true,
        "points_to": { "type": "array", "items": { "$ref": "#/$defs/pointer" } }
      },
      "additionalProperties": false
    },
    "faceName": { "enum": ["function", "design", "data", "testing", "non_functionals"] },
    "seam": {
      "allOf": [{ "$ref": "#/$defs/mark" }],
      "required": ["between"],
      "properties": {
        "condition": true, "statements": true, "evidence": true, "question": true,
        "decision": true, "reason": true, "note": true,
        "proposed_by": true, "confirmed_by": true,
        "between": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/faceName" }
        }
      },
      "additionalProperties": false
    },
    "border": {
      "allOf": [{ "$ref": "#/$defs/mark" }],
      "required": ["with"],
      "properties": {
        "condition": true, "statements": true, "evidence": true, "question": true,
        "decision": true, "reason": true, "note": true,
        "proposed_by": true, "confirmed_by": true,
        "with": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "condition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string" },
        "condition": { "enum": ["open", "parked", "settled", "reopened"] },
        "raised_by": { "type": "string" },
        "raised_on": { "$ref": "#/$defs/date" },
        "decision": { "$ref": "#/$defs/id" },
        "watched_by": {
          "type": "object",
          "required": ["measure"],
          "additionalProperties": false,
          "properties": {
            "measure": { "type": "string" },
            "reopen_when": { "type": "string" },
            "pointer": { "$ref": "#/$defs/pointer" }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "about", "decided", "by", "date", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "about": {
          "type": "string",
          "pattern": "^(face:(function|design|data|testing|non_functionals)|seam:[a-z_]+/[a-z_]+|border:[a-z0-9-]+|question:[a-z0-9-]+|cell)$"
        },
        "decided": { "type": "string" },
        "by": { "type": "string", "description": "A person. Software and agents may propose; they do not decide." },
        "date": { "$ref": "#/$defs/date" },
        "reason": { "type": "string" },
        "reopens_if": { "type": "string" },
        "proof": {
          "type": "array", "items": { "$ref": "#/$defs/pointer" },
          "description": "Tests that hold the decision in place. A decision with no proof is unproven."
        },
        "source": {
          "$ref": "#/$defs/pointer",
          "description": "0.2. Where the decision was first recorded, if it was made before it reached the comb."
        },
        "proposed_by": {
          "type": "string",
          "description": "0.2. The tool, agent or person that copied an earlier decision into the comb. It needs a source."
        },
        "confirmed_by": {
          "type": "string",
          "description": "0.2. The person who checked that the decision is recorded as it was made."
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["comb", "id", "name"],
      "additionalProperties": false,
      "properties": {
        "comb": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "repositories": {
          "type": "array",
          "description": "0.2. The other repositories that pointers may name. The repository holding the comb is not listed.",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "The value a pointer's `repo` uses." },
              "url": { "type": "string", "pattern": "^https?://" },
              "holds": { "type": "string", "description": "One line on what lives there." }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
              "text": { "type": "string" },
              "check": { "type": "string", "description": "A question to ask of any change." },
              "pointer": { "$ref": "#/$defs/pointer" }
            }
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "required": ["comb", "id", "name", "parent", "stage", "core", "faces", "questions"],
      "additionalProperties": false,
      "properties": {
        "comb": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parent": { "$ref": "#/$defs/id", "description": "The project id, or the id of a larger cell." },
        "stage": { "enum": ["concept", "specified", "building", "built", "retired"] },
        "core": {
          "type": "object",
          "required": ["problem", "for"],
          "additionalProperties": false,
          "properties": {
            "problem": { "type": "string" },
            "for": { "type": "string" },
            "excludes": { "type": "array", "items": { "type": "string" } },
            "source": { "$ref": "#/$defs/pointer" }
          }
        },
        "faces": {
          "type": "object",
          "required": ["function", "design", "data", "testing", "non_functionals"],
          "additionalProperties": false,
          "properties": {
            "function": { "$ref": "#/$defs/face" },
            "design": { "$ref": "#/$defs/face" },
            "data": { "$ref": "#/$defs/face" },
            "testing": { "$ref": "#/$defs/face" },
            "non_functionals": { "$ref": "#/$defs/face" }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "seams": { "type": "array", "items": { "$ref": "#/$defs/seam" } },
        "borders": { "type": "array", "items": { "$ref": "#/$defs/border" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
      }
    },
    "journey": {
      "type": "object",
      "required": ["comb", "id", "name", "actor", "steps"],
      "additionalProperties": false,
      "properties": {
        "comb": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "actor": { "type": "string" },
        "steps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["does", "reach"],
            "additionalProperties": false,
            "properties": {
              "does": { "type": "string" },
              "cell": { "$ref": "#/$defs/id" },
              "reach": { "enum": ["reached", "unreachable", "unknown"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
